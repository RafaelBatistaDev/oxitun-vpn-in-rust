# ProtonVPN account credentials (one account per tunnel group is fine —
# ProtonVPN allows 10 simultaneous connections per account).
PROTONVPN_USER=your_protonvpn_username
PROTONVPN_PASS=your_protonvpn_password

# Optional overrides:
# PROXY_PORT=8888
# VPN_DNS=10.2.0.1
# KILLSWITCH=on        # set to "off" only for debugging — NEVER in production
